# Gansi project configuration. The Qt version, compiler
# family, and target architecture are pinned here for reproducible builds.
[project]
name = "{{name}}"
qt_version = "{{qt_version}}"
compiler_family = "{{compiler_family}}"   # gcc | msvc | clang
target_arch = "{{target_arch}}"

[deployment]
bundle_name = "{{title}}"
app_id = "{{app_id}}" # Replace com.example.* before publishing.
