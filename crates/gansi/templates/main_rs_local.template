// Generated by gansi create --local.
use yse::*;

fn main() {
    let app = Application::init();
    let window = Window::new();
    window.set_title("{{title}}");
    window.set_size(320, 140);
    let column = window.column();

    let count = Var::new(0u32);
    let label = column.label("Count: 0");
    label.bind_text(&count.signal().map(|c| format!("Count: {c}")));

    let button = column.button("Increment");
    let count_rc = count.clone();
    let _sub = button.clicked().observe(move |_| {
        let next = *count_rc.value() + 1;
        count_rc.set(next);
    });

    if std::env::var("YSE_SMOKE").is_ok() {
        button.click();
        app.quit_after(300);
    }

    window.show();
    let code = app.exec();
    println!("count={}", count.value());
    std::process::exit(code);
}
